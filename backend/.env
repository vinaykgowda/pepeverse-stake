# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=/api/v1
JWT_SECRET=yourSuperSecretKey123
JWT_EXPIRY=24h

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
# SECURITY WARNING: Do not commit actual passwords to version control
# In production, use AWS Secrets Manager or similar secure secret storage
DB_PASSWORD=PepeGods@1306$
DB_NAME=solana_nft_staking

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet  # 'mainnet-beta', 'testnet', or 'devnet'

# Admin Configuration
ADMIN_WALLET=your-admin-wallet-address

# Security

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
# In development: localhost origins are automatically added
# In production: ONLY these origins will be allowed (no wildcard)
# Example: ALLOWED_ORIGINS=https://staking.example.com,https://www.staking.example.com
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

ENCRYPTION_KEY=mN4VbT8pWzQ2XeAhL9YrKdJ5FcXg03EuqZjRMv7wYaCNsPKo1UbGtHdXLey6WqBj

# NOTE: For production deployment:
# 1. Move all secrets (JWT_SECRET, DB_PASSWORD, ENCRYPTION_KEY) to AWS Secrets Manager
# 2. Remove this .env file from production servers
# 3. Use the SecretsManager class (backend/src/config/secrets.js) to load secrets
# 4. Ensure this file is in .gitignore and never committed with real credentials
DATABASE_URL=mysql://root:PepeGods@1306$@127.0.0.1:3306/solana_nft_staking
