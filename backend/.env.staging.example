# Staging Environment Configuration
# Copy this file to .env.staging and fill in your staging database credentials
# IMPORTANT: Never use production credentials in this file!

# Database Configuration
DB_HOST=staging-db.example.com
DB_PORT=3306
DB_USER=staging_user
DB_PASSWORD=your_staging_password_here
DB_NAME=solana_nft_staking_staging

# Environment
NODE_ENV=staging

# Notes:
# - This file should be used ONLY for staging database testing
# - Never commit .env.staging to version control
# - Ensure staging database is separate from production
# - Use different credentials for staging and production
# - Test database connection before running migrations:
#   mysql -h staging-db.example.com -u staging_user -p
